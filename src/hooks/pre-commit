#!/bin/sh

# Жестко определяем корень репозитория Git, где бы мы ни находились
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"


echo "========================================================="
echo "    DevSecOps: Запуск pre-commit проверок безопасности..."
echo "========================================================="

# 1. Автоматическое удаление пробелов на концах строк в индексированных файлах
# Находим все измененные текстовые файлы и очищаем их с помощью sed
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d | grep -E '\.(c|h|S|s|md|yaml|yml|ld)$')

if [ ! -z "$STAGED_FILES" ]; then
    echo "Очистка trailing-пробелов в измененных файлах..."
    for file in $STAGED_FILES; do
        if [ -f "$file" ]; then
            # Удаляем пробелы на конце строк
            sed -i 's/[[:space:]]*$//' "$file"
            # Переиндексируем файл после очистки
            git add "$file"
        fi
    done
    echo "Файлы очищены от мусорных пробелов."
fi

# 2 Проверка стиля Си-кода (Code Style Gate)
C_FILES=$(git diff --cached --name-only --diff-filter=d | grep -E '\.(c|h)$')
if [ ! -z "$C_FILES" ]; then
    echo "Проверка стиля кода (clang-format)..."
    docker run --rm \
        --user $(id -u):$(id -g) \
        -v "$REPO_ROOT":/workspace \
        riscv_os_devsecops:latest \
        clang-format --dry-run --Werror $C_FILES

    if [ $? -ne 0 ]; then
        echo "Ошибка стиля кода!"
        echo "Выполните 'make format' для автоматического исправления и повторите коммит."
        exit 1
    fi
fi
# # 2. Проверка форматирования Си-кода (если изменены .c или .h файлы)
# C_FILES=$(git diff --cached --name-only --diff-filter=d | grep -E '\.(c|h)$')
# if [ ! -z "$C_FILES" ]; then
#     echo "Проверка стиля кода (clang-format)..."
#     for file in $C_FILES; do
#         # Флаг --dry-run и --Werror заставят утилиту вернуть ошибку при любом отклонении от стиля
#         clang-format --dry-run --Werror "$file"
#         if [ $? -ne 0 ]; then
#             echo "Ошибка стиля в файле $file!"
#             echo "Выполните 'clang-format -i $file' для автоисправления."
#             exit 1
#         fi
#     done
# fi

# 3. Запуск статического анализа Cppcheck внутри нашего Docker-контейнера
echo "Запуск SAST-анализа кода через Cppcheck..."

# Проверяем, существует ли папка src
if [ -d "src" ]; then
    docker run --rm \
        --user $(id -u):$(id -g) \
        -v $(pwd):/workspace \
        riscv_os_devsecops:latest \
        cppcheck --enable=warning,performance,portability \
                 --error-exitcode=1 \
                 --suppress=missingIncludeSystem \
                 --inline-suppr \
                 src/

    if [ $? -ne 0 ]; then
        echo "Критическая ошибка: Cppcheck нашел баги или уязвимости в коде!"
        echo "Коммит заблокирован. Исправьте предупреждения выше."
        exit 1
    fi
fi

echo "Все проверки успешно пройдены! Коммит разрешен."
exit 0
