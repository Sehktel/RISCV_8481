#!/bin/sh
set -u

# Корень репозитория, где бы мы ни находились
REPO_ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$REPO_ROOT" || exit 1

echo "========================================================="
echo "    DevSecOps: Запуск pre-commit проверок безопасности..."
echo "========================================================="

# ---------------------------------------------------------------
# 1. Очистка trailing-пробелов в индексированных файлах
# ---------------------------------------------------------------
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d \
    | grep -E '\.(c|h|S|s|md|yaml|yml|ld)$' || true)

if [ -n "$STAGED_FILES" ]; then
    echo "Очистка trailing-пробелов в измененных файлах..."
    for file in $STAGED_FILES; do
        [ -f "$file" ] || continue
        sed -i 's/[[:space:]]*$//' "$file"
        git add -- "$file"
    done
    echo "Файлы очищены от мусорных пробелов."
fi

# ---------------------------------------------------------------
# 2. Code Style Gate (clang-format внутри контейнера)
# ---------------------------------------------------------------
if [ -d "src" ]; then
    echo "Проверка стиля кода (clang-format)..."
    make style
    if [ $? -ne 0 ]; then
        echo "Ошибка стиля кода!"
        echo "Выполните 'make format' для автоматического исправления и повторите коммит."
        exit 1
    fi
fi

# ---------------------------------------------------------------
# 3. SAST (cppcheck внутри контейнера)
# ---------------------------------------------------------------
if [ -d "src" ]; then
    echo "Запуск SAST-анализа кода через Cppcheck..."
    make sast
    status=$?
    if [ "$status" -ne 0 ]; then
        if [ "$status" -eq 127 ]; then
            echo "Ошибка окружения: не найден docker или инструмент в контейнере. Коммит не связан с кодом."
        else
            echo "Критическая ошибка: Cppcheck нашёл проблемы в коде!"
            echo "Коммит заблокирован. Исправьте предупреждения выше."
        fi
        exit 1
    fi
    echo "SAST: проверка пройдена."
fi

# ---------------------------------------------------------------
# 4. Аудит секретов перед коммитом (Gitleaks внутри контейнера)
# ---------------------------------------------------------------
echo "Запуск сканирования на утечку секретов (Gitleaks)..."
make -s secrets-staged
if [ $? -ne 0 ]; then
    echo "Критическая ошибка: Gitleaks обнаружил секрет или приватный ключ в индексе Git!"
    echo "Коммит заблокирован. Удалите секрет из файлов."
    exit 1
fi
echo "Secrets Audit: проверка пройдена."

echo "Все проверки успешно пройдены! Коммит разрешен."
exit 0
